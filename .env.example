# =============================================================================
# APEX Workspace — Environment template (local monorepo)
# Copy values into apps/api/.env and apps/web/.env.local as needed.
# Never commit real secrets. See DEPLOYMENT.md for Hostinger VPS production.
# =============================================================================

NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# CORS_ORIGINS=

# Local Postgres (recommended for development):
DATABASE_URL=postgresql://apex:apex_secret@localhost:5432/apex_workspace?schema=public
# Temporary dump source during migration (SSL remote hosts):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public&sslmode=require&connect_timeout=60

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_SECRET=change-me-csrf-secret-min-32-characters!!

# Bunny.net storage (only provider)
STORAGE_DRIVER=bunny
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_CDN_HOSTNAME=
# BUNNY_CDN_TOKEN_KEY=
# Required for private files on a public pull zone. Without it, private objects
# are streamed through the authenticated API instead of unsigned CDN URLs.
BUNNY_STORAGE_PATH_PREFIX=apex
STORAGE_PUBLIC_BASE=https://YOUR_PULLZONE.b-cdn.net

AI_PROVIDER=mock
AI_ASYNC_PIPELINE=true
AI_MAX_RETRIES=3
AI_ALLOW_MOCK_FALLBACK=true
AI_REQUEST_TIMEOUT_MS=120000

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
AI_IMAGE_PROVIDER=free
POLLINATIONS_IMAGE_MODEL=flux-realism
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

DEFAULT_MANAGER_EMAIL=manager@apex.af
DEFAULT_MANAGER_PASSWORD=ApexManager!2026
WHATSAPP_NUMBER=93700000000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# BACKUP_EMAIL_TO=
# PORTAL_EXPOSE_OTP=true
SIGNED_URL_SECRET=change-me-signed-url-secret-32chars!
SIGNED_URL_TTL_SECONDS=300
TZ=Asia/Kabul

# AES-256-GCM secret for recoverable portal passwords (manager assistance).
# PORTAL_CREDENTIAL_SECRET=change-me-portal-credential-secret-32chars!

# --- Frontend (apps/web/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# NEXT_PUBLIC_STORAGE_PUBLIC_BASE=http://localhost:4000/files
