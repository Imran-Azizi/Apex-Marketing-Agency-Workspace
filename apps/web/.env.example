# APEX Web (Next.js) — Vercel
# This project uses Next.js, NOT Vite. Public env vars must be prefixed with NEXT_PUBLIC_.

# Required — Railway API base including /api/v1 (no trailing slash after v1)
# Development:
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Production (example):
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app/api/v1

# Optional — public CDN / R2 / S3 / API /files base for previews (no trailing slash)
# When unset, falls back to {API origin}/files.
#
# Cloudinary testing (recommended): point at API redirect so resource-type URLs resolve correctly:
# NEXT_PUBLIC_STORAGE_PUBLIC_BASE=http://localhost:4000/files
#
# Production R2 example:
# NEXT_PUBLIC_STORAGE_PUBLIC_BASE=https://pub-xxxxx.r2.dev
# NEXT_PUBLIC_STORAGE_PUBLIC_BASE=https://cdn.example.com
