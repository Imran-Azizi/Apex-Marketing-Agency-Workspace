# APEX Web (Next.js) — local / Hostinger VPS
# This project uses Next.js, NOT Vite. Public env vars must be prefixed with NEXT_PUBLIC_.
# Production template: apps/web/deploy/.env.production.example

# Required — API base including /api/v1 (no trailing slash after v1)
# Development:
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Production (same domain behind Nginx):
# NEXT_PUBLIC_API_URL=https://smartapex.tech/api/v1

# Optional — public Bunny CDN / API /files base for previews (no trailing slash)
# When unset, falls back to {API origin}/files.
#
# Recommended: point at API redirect so auth-checked /files URLs resolve correctly:
# NEXT_PUBLIC_STORAGE_PUBLIC_BASE=http://localhost:4000/files
#
# Direct Bunny Pull Zone (faster public images/videos):
# NEXT_PUBLIC_STORAGE_PUBLIC_BASE=https://YOUR_PULLZONE.b-cdn.net
