# =============================================================================
# APEX Web (Next.js) — Production env for Hostinger KVM 2
# Copy to: /var/www/apex/apps/web/.env.production
# (Next.js loads .env.production at build AND runtime for server)
# NEVER commit real secrets. Only NEXT_PUBLIC_* are exposed to the browser.
# =============================================================================

NODE_ENV=production

# Same domain as the site — Nginx routes /api to the Express API
NEXT_PUBLIC_API_URL=https://smartapex.tech/api/v1

# Must match apps/api WEB_REVALIDATE_SECRET
WEB_REVALIDATE_SECRET=CHANGE_ME_MIN_32_CHARS_REVALIDATE_SECRET

# Prefer API /files redirect (auth-aware). Or set Bunny pull-zone for public assets:
NEXT_PUBLIC_STORAGE_PUBLIC_BASE=https://smartapex.tech/files
# NEXT_PUBLIC_STORAGE_PUBLIC_BASE=https://YOUR_PULLZONE.b-cdn.net
