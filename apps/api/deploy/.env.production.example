# =============================================================================
# APEX API — Production env for Hostinger KVM 2 (same-domain behind Nginx)
# Copy to: /var/www/apex/apps/api/.env
# NEVER commit real secrets. chmod 600 this file on the VPS.
# =============================================================================

NODE_ENV=production

# Internal listen port (Nginx proxies; do not open in UFW)
API_PORT=4000
# Bind only localhost (Nginx proxies; do not open 4000 in UFW)
HOST=127.0.0.1

# Public URLs (same domain — simpler cookies than split hosting)
API_URL=https://smartapex.tech
WEB_URL=https://smartapex.tech
# CORS_ORIGINS=   # optional extras; WEB_URL is always included

# Local Postgres on the VPS (127.0.0.1 is correct for Hostinger same-box)
DATABASE_URL=postgresql://apex:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/apex_workspace?schema=public

JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_ACCESS_SECRET!!
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_REFRESH_SECRET!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Same-origin HTTPS → lax + secure
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
CSRF_SECRET=CHANGE_ME_MIN_32_CHARS_CSRF_SECRET!!!!

SIGNED_URL_SECRET=CHANGE_ME_MIN_32_CHARS_SIGNED_URL!!!
SIGNED_URL_TTL_SECONDS=300

# Bunny.net (keep existing zones — do not migrate media to local disk)
STORAGE_DRIVER=bunny
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_CDN_HOSTNAME=
# BUNNY_CDN_TOKEN_KEY=
BUNNY_STORAGE_PATH_PREFIX=apex
STORAGE_PUBLIC_BASE=https://YOUR_PULLZONE.b-cdn.net

AI_PROVIDER=mock
AI_ASYNC_PIPELINE=true
AI_MAX_RETRIES=3
AI_ALLOW_MOCK_FALLBACK=true
AI_REQUEST_TIMEOUT_MS=120000

# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

DEFAULT_MANAGER_EMAIL=manager@apex.af
DEFAULT_MANAGER_PASSWORD=CHANGE_ME_STRONG_PASSWORD
WHATSAPP_NUMBER=93700000000
TZ=Asia/Kabul

# Optional SMTP for backup emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# BACKUP_EMAIL_TO=
