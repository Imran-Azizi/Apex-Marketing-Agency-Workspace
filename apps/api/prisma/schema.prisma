generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum RoleCode {
  MANAGER
  ADMIN
  SALES
  EDITOR
  NARRATOR
  FINANCE
  PROJECT_MANAGER
  CUSTOMER
  AI_SERVICE
}

enum SessionAudience {
  INTERNAL
  PORTAL
}

enum CrmPipelineStage {
  NEW_LEAD
  CONTACTED
  INFORMATION_SENT
  PROPOSAL_PRICE_SENT
  WAITING_DECISION
  ORDER_CONFIRMED
  DEPOSIT_PENDING
  DEPOSIT_CONFIRMED
  PORTAL_INVITED
  PROJECT_CREATED
  DELIVERED
  REPEAT_CUSTOMER
  LOST_CANCELED
}

enum PortalStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  INVITED
  REGISTERED
  SUSPENDED
}

enum ProjectStatus {
  NEW_MANAGER_REVIEW
  CONTENT_GENERATION
  INTERNAL_CONTENT_REVIEW
  WAITING_CLIENT_CONTENT_APPROVAL
  CONTENT_REVISION
  NARRATION_RECORDING
  PRODUCTION_EDITING
  MANAGER_FINAL_REVIEW
  FINAL_REVISION
  WAITING_CLIENT_FINAL_APPROVAL
  WAITING_PAYMENT
  READY_TO_DOWNLOAD
  COMPLETED
  ON_HOLD
  CANCELED
}

enum CustomerFacingStatus {
  INFO_RECEIVED
  PREPARING_CONTENT
  WAITING_YOUR_APPROVAL
  IN_PRODUCTION
  FINAL_REVIEW
  WAITING_PAYMENT
  READY_DELIVERY
  COMPLETED
}

enum AssignmentRole {
  MANAGER
  EDITOR
  NARRATOR
  PROPOSED_NARRATOR
}

enum ContentKind {
  BUNDLE
  SCENARIO
  NARRATION
  STORYBOARD
  FINAL_VIDEO
}

enum ApprovalType {
  MANAGER_CONTENT
  CLIENT_CONTENT
  MANAGER_FINAL
  CLIENT_FINAL
  VOICE_ACCEPT
  QC
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  RETURNED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  HAWALA
  HESAB_PAY
  CARD
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PayableStatus {
  ESTIMATED
  CONFIRMED
  PAID
}

enum ExpenseCategory {
  DIRECT_PROJECT
  COMPANY_GENERAL
}

enum CompensationType {
  FIXED
  PROJECT_SHARE
}

enum SalaryAdvanceStatus {
  OPEN
  SETTLED
}

enum AiAgentType {
  SCENARIO
  NARRATION
  STORYBOARD
}

enum AiRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AiAgentStatus {
  ACTIVE
  INACTIVE
}

enum ContentVersionStatus {
  DRAFT
  EDITED
  UNDER_REVIEW
  PENDING_CUSTOMER_APPROVAL
  REVISION_REQUESTED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum NarrationTaskStatus {
  PENDING_NARRATION
  RECORDING_IN_PROGRESS
  NARRATION_SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

enum EditingTaskStatus {
  ASSIGNED
  IN_PROGRESS
  REVIEW_REQUIRED
  REVISION_REQUESTED
  COMPLETED
}

enum EditingAssetType {
  IMAGE
  VIDEO
  AUDIO
  EXTERNAL
  AI_GENERATED
  OTHER
}

enum AiWorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum FileKind {
  LOGO
  PRODUCT_IMAGE
  VIDEO
  BRANDBOOK
  CATALOG
  REFERENCE
  PRONUNCIATION
  WORKING
  WATERMARKED_FINAL
  CLEAN_FINAL
  THUMBNAIL
  AUDIO
  PROMPT_LOG
  OTHER
  RECEIPT
  ATTACHMENT
  POSTER
}

enum PosterStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SENT_TO_CUSTOMER
}

enum PaymentSettlementStatus {
  UNPAID
  PARTIAL
  PAID
  OVERRIDE
}

enum DeliveryWorkflowStatus {
  NOT_READY
  AWAITING_PAYMENT
  AWAITING_MANAGER_APPROVAL
  READY_FOR_DOWNLOAD
  DELIVERED
  COMPLETED
}

enum CleanFileAccessStatus {
  HIDDEN
  LOCKED_PAYMENT
  LOCKED_APPROVAL
  AVAILABLE
}

enum TeamKind {
  EDITOR
  NARRATOR
  MANAGER
  SALES
  FINANCE
}

enum AvailabilityStatus {
  ACTIVE
  UNAVAILABLE
  INACTIVE
}

// ─── Auth / RBAC ─────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  passwordCipher String?
  fullName     String
  phone        String?
  profileImage String?
  cvStorageKey String?
  cvFileName   String?
  cvMimeType   String?
  cvSizeBytes  Int?
  cvUploadedAt DateTime?
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?
  roleId       String
  role         Role         @relation(fields: [roleId], references: [id])
  teamProfile  TeamProfile?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  sessions                Session[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  assignedCustomers       CrmCustomer[]       @relation("SalesOwner")
  crmActivities           CrmActivity[]       @relation("CrmActivityActor")
  managedProjects         Project[]           @relation("ProjectManager")
  verifiedPayments        Payment[]           @relation("PaymentVerifier")
  recordedPayments        Payment[]           @relation("PaymentRecorder")
  rejectedPayments        Payment[]           @relation("PaymentRejector")
  aiRuns                  AiRun[]
  projectAssignments      ProjectAssignment[]
  narrationTasksAssigned  NarrationTask[]     @relation("NarrationTaskNarrator")
  narrationTasksCreated   NarrationTask[]     @relation("NarrationTaskAssigner")
  narrationTakesUploaded  NarrationTake[]     @relation("NarrationTakeUploader")
  editingTasksAssigned    EditingTask[]       @relation("EditingTaskEditor")
  editingTasksCreated     EditingTask[]       @relation("EditingTaskAssigner")
  editingResources        EditingResource[]
  systemBackupsCreated    SystemBackup[]      @relation("BackupCreator")
  userPermissions         UserPermission[]
  portfolioItemsPublished PortfolioItem[]     @relation("PortfolioPublisher")
  expensesPaid            Expense[]           @relation("ExpensePayer")
  salaryPaymentsRecorded  SalaryPayment[]     @relation("SalaryPaymentRecorder")
  salaryAdvancesRecorded  SalaryAdvance[]     @relation("SalaryAdvanceRecorder")
  financePnlTargets       FinancePnlTarget[]  @relation("FinancePnlTargetCreator")
  chatOrgSettingsUpdated  ChatOrgSettings[]   @relation("ChatOrgSettingsUpdater")
  chatConversationsCreated ChatConversation[] @relation("ChatConversationCreator")
  chatParticipations      ChatParticipant[]
  chatMessagesSent        ChatMessage[]       @relation("ChatMessageSender")
  chatMessageDeliveries   ChatMessageDelivery[]
  chatMessageReactions    ChatMessageReaction[]
  chatAllowPairsGranted   ChatEmployeeAllowPair[] @relation("ChatAllowPairGranter")
  chatAllowPairsAsLow     ChatEmployeeAllowPair[] @relation("ChatAllowPairLow")
  chatAllowPairsAsHigh    ChatEmployeeAllowPair[] @relation("ChatAllowPairHigh")
  salesAssistantOwned     SalesAssistantRecommendation[] @relation("SalesAssistantOwner")
  salesAssistantActed     SalesAssistantRecommendation[] @relation("SalesAssistantActor")
  salesAssistantSettings  SalesAssistantSettings[]       @relation("SalesAssistantSettingsUpdater")
  businessAssistantActed  BusinessAssistantInsight[]     @relation("BusinessAssistantActor")
  businessAssistantSettings BusinessAssistantSettings[]  @relation("BusinessAssistantSettingsUpdater")
  businessAssistantTargets BusinessAssistantMonthlyTarget[] @relation("BusinessAssistantTargetCreator")
  businessAssistantChat   BusinessAssistantChatMessage[] @relation("BusinessAssistantChatter")
  postersUploaded         ProjectPoster[]     @relation("PosterUploader")
  postersReviewed         ProjectPoster[]     @relation("PosterReviewer")
  postersDelivered        ProjectPoster[]     @relation("PosterDeliverer")

  @@index([deletedAt])
  @@index([roleId])
  @@index([isActive, deletedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  code        RoleCode         @unique
  name        String
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
  users       UserPermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

model Session {
  id               String          @id @default(cuid())
  audience         SessionAudience
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalAccountId  String?
  portalAccount    PortalAccount?  @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([refreshTokenHash])
  @@index([userId])
  @@index([portalAccountId])
  @@map("sessions")
}

// ─── CRM ─────────────────────────────────────────────────

model CrmCustomer {
  id                 String           @id @default(cuid())
  /// Public customer identity (APEX-00001). Survives lead → customer conversion.
  customerCode       String           @unique
  personName         String
  companyName        String?
  jobTitle           String?
  phone              String?
  whatsappRaw        String
  normalizedWhatsapp String           @unique
  phoneCountryIso    String?
  previousWhatsapp   Json?
  city               String?
  address            String?
  email              String?
  source             String?
  salesOwnerId       String?
  salesOwner         User?            @relation("SalesOwner", fields: [salesOwnerId], references: [id])
  pipelineStage      CrmPipelineStage @default(NEW_LEAD)
  /// Set when the lead is converted into Customer Management after deposit confirmation.
  convertedAt        DateTime?
  customerInfoSavedAt DateTime?
  portalStatus       PortalStatus     @default(NOT_ELIGIBLE)
  lastContactAt      DateTime?
  nextFollowUpAt     DateTime?
  notes              String?
  lostReason         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  opportunities   Opportunity[]
  portalAccount   PortalAccount?
  clientAssets    ClientAsset[]
  projects        Project[]
  invoices        Invoice[]
  payments        Payment[]
  activities      CrmActivity[]
  contactMessages ContactMessage[]
  whatsappInboundEvents WhatsAppInboundEvent[]
  salesAssistantRecommendations SalesAssistantRecommendation[]
  posters         ProjectPoster[]

  @@index([pipelineStage])
  @@index([portalStatus])
  @@index([deletedAt])
  @@index([salesOwnerId])
  @@index([nextFollowUpAt])
  @@index([customerCode])
  @@index([convertedAt])
  @@index([lastContactAt])
  @@index([deletedAt, updatedAt])
  @@index([source])
  @@map("crm_customers")
}

/// Idempotent WhatsApp Cloud API inbound webhook events (Meta wamid).
model WhatsAppInboundEvent {
  id            String       @id @default(cuid())
  /// Meta WhatsApp message id (wamid.*) — unique for retry/idempotency.
  providerMsgId String       @unique
  fromWaId      String
  normalizedWa  String?
  displayName   String?
  /// Stored truncated for CRM linking; not full conversation archive.
  textPreview   String?      @db.VarChar(280)
  sourceHint    String?
  status        String       @default("RECEIVED")
  crmCustomerId String?
  crmCustomer   CrmCustomer? @relation(fields: [crmCustomerId], references: [id], onDelete: SetNull)
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime     @default(now())
  processedAt   DateTime?
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([normalizedWa])
  @@index([crmCustomerId])
  @@index([createdAt])
  @@map("whatsapp_inbound_events")
}

/// Immutable CRM activity / status / interaction timeline
model CrmActivity {
  id             String      @id @default(cuid())
  crmCustomerId  String
  crmCustomer    CrmCustomer @relation(fields: [crmCustomerId], references: [id], onDelete: Cascade)
  type           String
  title          String
  body           String?     @db.Text
  previousStatus String?
  newStatus      String?
  actorId        String?
  actor          User?       @relation("CrmActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorType      String      @default("SYSTEM")
  source         String?
  relatedType    String?
  relatedId      String?
  meta           Json?
  createdAt      DateTime    @default(now())

  @@index([crmCustomerId, createdAt])
  @@index([type])
  @@index([relatedType, relatedId])
  @@map("crm_activities")
}

model Opportunity {
  id                 String           @id @default(cuid())
  crmCustomerId      String
  crmCustomer        CrmCustomer      @relation(fields: [crmCustomerId], references: [id])
  title              String
  pipelineStage      CrmPipelineStage @default(NEW_LEAD)
  proposedPrice      Decimal?         @db.Decimal(14, 2)
  agreedPrice        Decimal?         @db.Decimal(14, 2)
  advancePayment     Decimal?         @db.Decimal(14, 2)
  agreedTerms        String?
  /**
   * Once true, agreedPrice + agreedTerms cannot change without admin unlock.
   */
  contractLocked     Boolean          @default(false)
  contractLockedAt   DateTime?
  contractLockedById String?
  currency           String           @default("AFN")
  serviceId          String?
  service            Service?         @relation(fields: [serviceId], references: [id])
  lostReason         String?
  projectId          String?          @unique
  project            Project?         @relation(fields: [projectId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  invoices      Invoice[]
  portalInvites PortalInvite[]

  @@index([pipelineStage])
  @@index([crmCustomerId])
  @@index([deletedAt])
  @@map("opportunities")
}

// ─── Portal ──────────────────────────────────────────────

model PortalAccount {
  id                 String      @id @default(cuid())
  crmCustomerId      String      @unique
  crmCustomer        CrmCustomer @relation(fields: [crmCustomerId], references: [id])
  normalizedWhatsapp String      @unique
  passwordHash       String?
  /// AES-256-GCM recoverable copy for authorized manager assistance. Never log or return in public APIs.
  passwordCipher     String?
  isActive           Boolean     @default(true)
  registeredAt       DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  sessions Session[]
  invites  PortalInvite[]
  projects Project[]
  otpCodes OtpCode[]

  @@map("portal_accounts")
}

model PortalInvite {
  id              String         @id @default(cuid())
  crmCustomerId   String
  opportunityId   String
  opportunity     Opportunity    @relation(fields: [opportunityId], references: [id])
  portalAccountId String?
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id])
  whatsappNumber  String
  /// AES-256-GCM copy of the password the customer created. Null until registration.
  passwordCipher  String?
  token           String         @unique
  maxAttempts     Int            @default(5)
  attempts        Int            @default(0)
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  otpCodes OtpCode[]

  @@index([token])
  @@index([crmCustomerId])
  @@map("portal_invites")
}

model OtpCode {
  id              String         @id @default(cuid())
  codeHash        String
  portalInviteId  String?
  portalInvite    PortalInvite?  @relation(fields: [portalInviteId], references: [id])
  portalAccountId String?
  portalAccount   PortalAccount? @relation(fields: [portalAccountId], references: [id])
  purpose         String         @default("REGISTER")
  attempts        Int            @default(0)
  maxAttempts     Int            @default(5)
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime       @default(now())

  @@index([portalInviteId])
  @@map("otp_codes")
}

model ClientAsset {
  id            String      @id @default(cuid())
  crmCustomerId String
  crmCustomer   CrmCustomer @relation(fields: [crmCustomerId], references: [id])
  kind          FileKind
  name          String
  storageKey    String
  mimeType      String?
  sizeBytes     Int?
  meta          Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  references AssetReference[]

  @@index([crmCustomerId])
  @@map("client_assets")
}

// ─── Catalog ─────────────────────────────────────────────

model Service {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  imageKey        String?
  startingPrice   Decimal?  @db.Decimal(14, 2)
  durationOptions Json?
  outputs         Json?
  revisionCount   Int       @default(2)
  isPublished     Boolean   @default(true)
  sortOrder       Int       @default(0)
  ctaLabel        String?
  ctaHref         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  styles        Style[]
  opportunities Opportunity[]
  projects      Project[]

  @@index([isPublished, deletedAt, sortOrder])
  @@map("services")
}

model Style {
  id           String    @id @default(cuid())
  serviceId    String?
  service      Service?  @relation(fields: [serviceId], references: [id])
  name         String
  slug         String    @unique
  description  String?
  thumbnailKey String?
  previewKey   String?
  isPublished  Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@map("styles")
}

model Format {
  id        String   @id @default(cuid())
  name      String
  ratio     String   @unique
  createdAt DateTime @default(now())

  projects Project[]

  @@map("formats")
}

// ─── Team ────────────────────────────────────────────────

model TeamProfile {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id])
  kind        TeamKind
  displayName String
  realName    String?
  languages   Json?
  gender      String?
  tone        String?
  specialties Json?
  status      AvailabilityStatus @default(ACTIVE)
  paymentInfo Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  rates                 Rate[]
  audioSamples          AudioSample[]
  assignments           ProjectAssignment[]
  employeePayables      EmployeePayable[]
  narrationTasks        NarrationTask[]
  editingTasks          EditingTask[]
  compensationProfile   EmployeeCompensationProfile?
  salaryPayments        SalaryPayment[]
  salaryAdvances        SalaryAdvance[]

  @@map("team_profiles")
}

model Rate {
  id            String      @id @default(cuid())
  teamProfileId String
  teamProfile   TeamProfile @relation(fields: [teamProfileId], references: [id])
  label         String
  durationSec   Int?
  amount        Decimal     @db.Decimal(14, 2)
  currency      String      @default("AFN")
  serviceId     String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([teamProfileId])
  @@map("rates")
}

model AudioSample {
  id            String      @id @default(cuid())
  teamProfileId String
  teamProfile   TeamProfile @relation(fields: [teamProfileId], references: [id])
  title         String
  language      String?
  gender        String?
  tone          String?
  storageKey    String
  isPublished   Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@index([teamProfileId])
  @@map("audio_samples")
}

// ─── Projects ────────────────────────────────────────────

model Project {
  id                   String                  @id @default(cuid())
  code                 String                  @unique
  title                String
  status               ProjectStatus           @default(NEW_MANAGER_REVIEW)
  customerFacingStatus CustomerFacingStatus    @default(INFO_RECEIVED)
  crmCustomerId        String
  crmCustomer          CrmCustomer             @relation(fields: [crmCustomerId], references: [id])
  portalAccountId      String?
  portalAccount        PortalAccount?          @relation(fields: [portalAccountId], references: [id])
  managerId            String
  manager              User                    @relation("ProjectManager", fields: [managerId], references: [id])
  serviceId            String?
  service              Service?                @relation(fields: [serviceId], references: [id])
  formatId             String?
  format               Format?                 @relation(fields: [formatId], references: [id])
  durationSec          Int?
  language             String?
  tone                 String?
  platforms            Json?
  brief                Json?
  deadlineAt           DateTime?
  contentRevisionUsed  Int                     @default(0)
  contentRevisionMax   Int                     @default(2)
  videoRevisionUsed    Int                     @default(0)
  videoRevisionMax     Int                     @default(2)
  extraContentRevision Boolean                 @default(false)
  extraVideoRevision   Boolean                 @default(false)
  holdReason           String?
  /// Denormalized settlement: UNPAID | PARTIAL | PAID | OVERRIDE
  paymentStatus        PaymentSettlementStatus @default(UNPAID)
  /// Delivery workflow gate for clean-file access
  deliveryStatus       DeliveryWorkflowStatus  @default(NOT_READY)
  /// Customer-visible clean file access state
  cleanFileAccess      CleanFileAccessStatus   @default(HIDDEN)
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?
  /// Client-generated key so duplicate submits reuse the same project.
  createIdempotencyKey String?                 @unique

  opportunity        Opportunity?
  context            ProjectContext?
  finance            ProjectFinance?
  assignments        ProjectAssignment[]
  files              ProjectFile[]
  assetRefs          AssetReference[]
  contentVersions    ContentVersion[]
  approvals          Approval[]
  feedback           ClientFeedback[]
  aiRuns             AiRun[]
  aiWorkflows        AiWorkflowExecution[]
  aiActivityLogs     AiActivityLog[]
  invoices           Invoice[]
  expenses           Expense[]
  payables           EmployeePayable[]
  downloadPermission DownloadPermission?
  downloadHistory    DownloadHistory[]
  timeline           ProjectTimelineEvent[]
  narrationTasks     NarrationTask[]
  editingTasks       EditingTask[]
  editingResources   EditingResource[]
  portfolioItems     PortfolioItem[]
  posters            ProjectPoster[]

  @@index([status])
  @@index([crmCustomerId])
  @@index([managerId])
  @@index([deliveryStatus])
  @@index([paymentStatus])
  @@index([deletedAt])
  @@index([deletedAt, status])
  @@index([deletedAt, updatedAt])
  @@index([customerFacingStatus])
  @@index([portalAccountId])
  @@map("projects")
}

model ProjectTimelineEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  meta      Json?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("project_timeline_events")
}

model ProjectAssignment {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role          AssignmentRole
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])
  teamProfileId String?
  teamProfile   TeamProfile?   @relation(fields: [teamProfileId], references: [id])
  assignedById  String?
  deadlineAt    DateTime?
  notes         String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([projectId])
  @@index([teamProfileId])
  @@index([userId])
  @@map("project_assignments")
}

model ProjectFile {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       FileKind
  name       String
  storageKey String
  mimeType   String?
  sizeBytes  Int?
  version    Int       @default(1)
  meta       Json?
  uploadedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  narrationTasksAsCurrent NarrationTask[] @relation("NarrationTaskCurrentAudio")
  narrationTakes          NarrationTake[]
  editingWatermarkedFor   EditingTask[]   @relation("EditingWatermarkedFile")
  editingCleanFor         EditingTask[]   @relation("EditingCleanFile")
  portfolioItems          PortfolioItem[]
  posters                 ProjectPoster[]

  @@index([projectId, kind])
  @@map("project_files")
}

model PortfolioCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  isSystem  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items PortfolioItemCategory[]

  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("portfolio_categories")
}

model PortfolioItemCategory {
  itemId     String
  categoryId String
  sortOrder  Int      @default(0)
  item       PortfolioItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category   PortfolioCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([itemId, categoryId])
  @@index([categoryId, sortOrder])
  @@map("portfolio_item_categories")
}

model MixedPortfolioItem {
  itemId    String        @id
  item      PortfolioItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([sortOrder])
  @@map("mixed_portfolio_items")
}

/// Public showcase entries — from completed projects or direct manager uploads
model PortfolioItem {
  id            String          @id @default(cuid())
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  videoFileId   String?
  videoFile     ProjectFile?    @relation(fields: [videoFileId], references: [id], onDelete: Restrict)
  storageKey    String?
  thumbnailKey  String?
  title         String
  description   String?
  /// Manager-approved public case study / Success Story
  successStory  String?         @db.Text
  slug          String          @unique
  status        PortfolioStatus @default(PUBLISHED)
  sortOrder     Int             @default(0)
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?           @relation("PortfolioPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  categories  PortfolioItemCategory[]
  mixedEntry  MixedPortfolioItem?

  @@index([status, publishedAt])
  @@index([projectId])
  @@index([videoFileId])
  @@index([deletedAt])
  @@index([deletedAt, status])
  @@index([sortOrder])
  @@map("portfolio_items")
}

/// Stage 11 — narration recording workflow after content approval
model NarrationTask {
  id                      String              @id @default(cuid())
  projectId               String
  project                 Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentVersionId        String?
  contentVersion          ContentVersion?     @relation(fields: [contentVersionId], references: [id])
  narratorUserId          String?
  narratorUser            User?               @relation("NarrationTaskNarrator", fields: [narratorUserId], references: [id])
  narratorTeamProfileId   String?
  narratorTeamProfile     TeamProfile?        @relation(fields: [narratorTeamProfileId], references: [id])
  assignedById            String?
  assignedBy              User?               @relation("NarrationTaskAssigner", fields: [assignedById], references: [id])
  status                  NarrationTaskStatus @default(PENDING_NARRATION)
  deadline                DateTime?
  assignedAmount          Decimal?            @db.Decimal(14, 2)
  narrationScriptSnapshot Json?
  audioFileId             String?
  audioFile               ProjectFile?        @relation("NarrationTaskCurrentAudio", fields: [audioFileId], references: [id])
  revisionNotes           String?
  submittedAt             DateTime?
  approvedAt              DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  takes NarrationTake[]

  @@index([projectId, status])
  @@index([narratorUserId, status])
  @@index([deadline])
  @@map("narration_tasks")
}

model NarrationTake {
  id            String        @id @default(cuid())
  taskId        String
  task          NarrationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectFileId String
  projectFile   ProjectFile   @relation(fields: [projectFileId], references: [id])
  version       Int
  notes         String?
  uploadedById  String?
  uploadedBy    User?         @relation("NarrationTakeUploader", fields: [uploadedById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([taskId, version])
  @@map("narration_takes")
}

/// Video production / editing workflow after narration approval
model EditingTask {
  id                  String            @id @default(cuid())
  projectId           String
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  editorUserId        String?
  editorUser          User?             @relation("EditingTaskEditor", fields: [editorUserId], references: [id])
  editorTeamProfileId String?
  editorTeamProfile   TeamProfile?      @relation(fields: [editorTeamProfileId], references: [id])
  assignedById        String?
  assignedBy          User?             @relation("EditingTaskAssigner", fields: [assignedById], references: [id])
  status              EditingTaskStatus @default(ASSIGNED)
  deadline            DateTime?
  assignedAmount      Decimal?          @db.Decimal(14, 2)
  instructions        String?
  revisionNotes       String?
  version             Int               @default(1)
  watermarkedFileId   String?
  watermarkedFile     ProjectFile?      @relation("EditingWatermarkedFile", fields: [watermarkedFileId], references: [id])
  cleanFileId         String?
  cleanFile           ProjectFile?      @relation("EditingCleanFile", fields: [cleanFileId], references: [id])
  submittedAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  resources EditingResource[]

  @@index([projectId, status])
  @@index([editorUserId, status])
  @@index([deadline])
  @@map("editing_tasks")
}

model EditingResource {
  id            String           @id @default(cuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  editingTaskId String
  editingTask   EditingTask      @relation(fields: [editingTaskId], references: [id], onDelete: Cascade)
  editorId      String?
  editor        User?            @relation(fields: [editorId], references: [id])
  assetType     EditingAssetType @default(OTHER)
  assetName     String
  assetUrl      String?
  aiTool        String?
  promptUsed    String?          @db.Text
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId])
  @@index([editingTaskId])
  @@map("editing_resources")
}

/// Project poster versions — editor upload, manager review, customer delivery
model ProjectPoster {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crmCustomerId   String
  crmCustomer     CrmCustomer  @relation(fields: [crmCustomerId], references: [id])
  fileId          String       @unique
  file            ProjectFile  @relation(fields: [fileId], references: [id], onDelete: Restrict)
  version         Int
  notes           String?      @db.Text
  status          PosterStatus @default(PENDING_REVIEW)
  uploadedById    String?
  uploadedBy      User?        @relation("PosterUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  reviewedBy      User?        @relation("PosterReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?      @db.Text
  deliveredAt     DateTime?
  deliveredById   String?
  deliveredBy     User?        @relation("PosterDeliverer", fields: [deliveredById], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([projectId, version])
  @@index([projectId, status])
  @@index([crmCustomerId])
  @@index([status])
  @@map("project_posters")
}

model AssetReference {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientAssetId String
  clientAsset   ClientAsset @relation(fields: [clientAssetId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([projectId, clientAssetId])
  @@map("asset_references")
}

model ProjectContext {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contextJson Json
  contextMd   String   @db.Text
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("project_context")
}

model ContentVersion {
  id                String               @id @default(cuid())
  projectId         String
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind              ContentKind          @default(BUNDLE)
  versionNumber     Int
  scenario          Json?
  narration         Json?
  storyboard        Json?
  /// Provider metadata (model, tokens, stepResults, fallback notices)
  extras            Json?
  status            ContentVersionStatus @default(DRAFT)
  isLocked          Boolean              @default(false)
  publishedToClient Boolean              @default(false)
  publishedAt       DateTime?
  approvedById      String?
  rejectedById      String?
  rejectionReason   String?
  changeNotes       String?
  createdById       String?
  aiRunId           String?
  workflowId        String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  approvals      Approval[]
  feedback       ClientFeedback[]
  narrationTasks NarrationTask[]

  @@unique([projectId, kind, versionNumber])
  @@index([projectId])
  @@index([projectId, status])
  @@index([publishedToClient])
  @@index([publishedToClient, isLocked])
  @@map("content_versions")
}

model Approval {
  id               String           @id @default(cuid())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentVersionId String?
  contentVersion   ContentVersion?  @relation(fields: [contentVersionId], references: [id])
  type             ApprovalType
  decision         ApprovalDecision
  comment          String?
  actorType        String
  actorId          String?
  createdAt        DateTime         @default(now())

  @@index([projectId])
  @@map("approvals")
}

model ClientFeedback {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentVersionId String?
  contentVersion   ContentVersion? @relation(fields: [contentVersionId], references: [id])
  scope            String
  body             String
  createdAt        DateTime        @default(now())

  @@index([projectId])
  @@map("client_feedback")
}

model AiAgent {
  id             String        @id @default(cuid())
  code           AiAgentType   @unique
  name           String
  nameFa         String?
  description    String?
  descriptionFa  String?
  status         AiAgentStatus @default(ACTIVE)
  promptTemplate String?       @db.Text
  promptVersion  String        @default("v1")
  config         Json?
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("ai_agents")
}

model AiWorkflowExecution {
  id               String           @id @default(cuid())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status           AiWorkflowStatus @default(PENDING)
  /// Ordered step states: [{ key, label, agentType?, status, startedAt?, finishedAt?, error? }]
  steps            Json
  contentVersionId String?
  error            String?
  triggeredById    String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  runs AiRun[]

  @@index([projectId, createdAt])
  @@index([status])
  @@map("ai_workflow_executions")
}

model AiRun {
  id            String               @id @default(cuid())
  projectId     String?
  project       Project?             @relation(fields: [projectId], references: [id])
  workflowId    String?
  workflow      AiWorkflowExecution? @relation(fields: [workflowId], references: [id])
  agentType     AiAgentType
  promptVersion String
  model         String
  input         Json
  output        Json?
  /// { promptTokens, completionTokens, totalTokens }
  tokenUsage    Json?
  durationMs    Int?
  status        AiRunStatus          @default(PENDING)
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  userId        String?
  user          User?                @relation(fields: [userId], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([projectId, createdAt])
  @@index([workflowId])
  @@map("ai_runs")
}

model AiActivityLog {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String?
  action     String
  entityType String?
  entityId   String?
  message    String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("ai_activity_logs")
}

model AiSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("ai_settings")
}

// ─── Finance ─────────────────────────────────────────────

model ProjectFinance {
  id                String   @id @default(cuid())
  projectId         String   @unique
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  basePrice         Decimal  @default(0) @db.Decimal(14, 2)
  agreedPrice       Decimal  @default(0) @db.Decimal(14, 2)
  discount          Decimal  @default(0) @db.Decimal(14, 2)
  discountReason    String?
  finalProjectPrice Decimal  @default(0) @db.Decimal(14, 2)
  narratorCost      Decimal  @default(0) @db.Decimal(14, 2)
  editorCost        Decimal  @default(0) @db.Decimal(14, 2)
  otherDirectCosts  Decimal  @default(0) @db.Decimal(14, 2)
  received          Decimal  @default(0) @db.Decimal(14, 2)
  currency          String   @default("AFN")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("project_finance")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  crmCustomerId String
  crmCustomer   CrmCustomer   @relation(fields: [crmCustomerId], references: [id])
  opportunityId String?
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id])
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  dueAt         DateTime?
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  currency      String        @default("AFN")
  notes             String?
  videoCount        Int?
  paymentMethod     PaymentMethod?
  paymentMethodMeta Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([crmCustomerId])
  @@index([status])
  @@index([opportunityId])
  @@index([projectId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id              String             @id @default(cuid())
  crmCustomerId   String
  crmCustomer     CrmCustomer        @relation(fields: [crmCustomerId], references: [id])
  invoiceId       String?
  invoice         Invoice?           @relation(fields: [invoiceId], references: [id])
  amount          Decimal            @db.Decimal(14, 2)
  paidAt          DateTime           @default(now())
  method          PaymentMethod
  methodMeta      Json?
  reference       String?
  attachmentKey   String?
  /// Approval workflow: PENDING → VERIFIED (approved) | REJECTED
  /// Only VERIFIED payments affect financial calculations.
  verification    VerificationStatus @default(PENDING)
  verifiedAt      DateTime?
  verifiedById    String?
  verifiedBy      User?              @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?              @relation("PaymentRejector", fields: [rejectedById], references: [id])
  rejectionReason String?
  recordedById    String?
  recordedBy      User?              @relation("PaymentRecorder", fields: [recordedById], references: [id])
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([invoiceId])
  @@index([verification])
  @@index([verification, paidAt])
  @@index([crmCustomerId])
  @@index([createdAt])
  @@map("payments")
}

model Expense {
  id            String          @id @default(cuid())
  projectId     String?
  project       Project?        @relation(fields: [projectId], references: [id])
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(14, 2)
  expenseDate   DateTime        @default(now())
  paymentMethod PaymentMethod?
  /// What the expense was for
  description   String?
  /// Who received the payment
  recipient     String?
  /// Account / payment basis label (e.g. office petty cash, bank)
  accountLabel  String?
  receiptKey    String?
  paidByUserId  String?
  paidBy        User?           @relation("ExpensePayer", fields: [paidByUserId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([projectId])
  @@index([category, expenseDate])
  @@index([paidByUserId])
  @@map("expenses")
}

model EmployeePayable {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id])
  teamProfileId String
  teamProfile   TeamProfile    @relation(fields: [teamProfileId], references: [id])
  roleLabel     String
  amount        Decimal        @db.Decimal(14, 2)
  status        PayableStatus  @default(ESTIMATED)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([projectId])
  @@index([teamProfileId, status])
  @@map("employee_payables")
}

/// Fixed salary vs project-share compensation settings for a team member.
model EmployeeCompensationProfile {
  id                 String           @id @default(cuid())
  teamProfileId      String           @unique
  teamProfile        TeamProfile      @relation(fields: [teamProfileId], references: [id], onDelete: Cascade)
  type               CompensationType @default(PROJECT_SHARE)
  fixedMonthlyAmount Decimal          @default(0) @db.Decimal(14, 2)
  currency           String           @default("AFN")
  notes              String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([type, isActive])
  @@map("employee_compensation_profiles")
}

/// Recorded salary / commission payouts to employees.
model SalaryPayment {
  id            String         @id @default(cuid())
  teamProfileId String
  teamProfile   TeamProfile    @relation(fields: [teamProfileId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(14, 2)
  paidAt        DateTime       @default(now())
  method        PaymentMethod
  notes         String?
  recordedById  String?
  recordedBy    User?          @relation("SalaryPaymentRecorder", fields: [recordedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([teamProfileId, paidAt])
  @@index([recordedById])
  @@map("salary_payments")
}

/// Salary advances (پیش‌پرداخت) visible to Finance.
model SalaryAdvance {
  id            String              @id @default(cuid())
  teamProfileId String
  teamProfile   TeamProfile         @relation(fields: [teamProfileId], references: [id], onDelete: Cascade)
  amount        Decimal             @db.Decimal(14, 2)
  paidAt        DateTime            @default(now())
  method        PaymentMethod?
  status        SalaryAdvanceStatus @default(OPEN)
  notes         String?
  recordedById  String?
  recordedBy    User?               @relation("SalaryAdvanceRecorder", fields: [recordedById], references: [id])
  settledAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([teamProfileId, status])
  @@index([recordedById])
  @@map("salary_advances")
}

/// Monthly net-profit and advertising-budget targets for P&L.
model FinancePnlTarget {
  id                String         @id @default(cuid())
  year              Int
  month             Int
  netProfitTarget   Decimal        @db.Decimal(14, 2)
  advertisingBudget Decimal        @db.Decimal(14, 2)
  createdById       String?
  createdBy         User?          @relation("FinancePnlTargetCreator", fields: [createdById], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([year, month])
  @@index([createdById])
  @@map("finance_pnl_targets")
}

// ─── Delivery ────────────────────────────────────────────

model DownloadPermission {
  id              String    @id @default(cuid())
  projectId       String    @unique
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allowed         Boolean   @default(false)
  allowedAt       DateTime?
  allowedById     String?
  revokedAt       DateTime?
  revokeReason    String?
  overrideBalance Boolean   @default(false)
  overrideReason  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  history DownloadHistory[]

  @@map("download_permissions")
}

model DownloadHistory {
  id                   String             @id @default(cuid())
  downloadPermissionId String
  downloadPermission   DownloadPermission @relation(fields: [downloadPermissionId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  portalAccountId      String?
  crmCustomerId        String?
  fileId               String?
  fileType             String?
  signedUrlExpiresAt   DateTime?
  tokenHash            String?
  revokedAt            DateTime?
  downloadedAt         DateTime?
  ipAddress            String?
  userAgent            String?
  meta                 Json?
  createdAt            DateTime           @default(now())

  @@index([projectId, createdAt])
  @@index([portalAccountId])
  @@map("download_history")
}

// ─── System ──────────────────────────────────────────────

model Notification {
  id              String    @id @default(cuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience        String    @default("INTERNAL")
  portalAccountId String?
  title           String
  body            String?
  link            String?
  isRead          Boolean   @default(false)
  meta            Json?
  createdAt       DateTime  @default(now())
  readAt          DateTime?
  seenAt          DateTime?

  @@index([userId, isRead])
  @@index([portalAccountId, isRead])
  @@index([userId, seenAt])
  @@index([portalAccountId, seenAt])
  @@index([createdAt])
  @@map("notifications")
}

/// Public website Hero slideshow slides (manager CMS)
model HeroSlide {
  id                String    @id @default(cuid())
  title             String
  description       String?   @db.Text
  imageKey          String
  altText           String?
  durationSeconds   Int       @default(5)
  sortOrder         Int       @default(0)
  isPublished       Boolean   @default(true)
  /// When true, show a CTA button on this slide on the public site.
  buttonEnabled     Boolean   @default(false)
  buttonText        String?
  /// Public section id (home/about/services/…) or "external".
  buttonDestination String?
  /// Required when buttonDestination = "external".
  buttonUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([isPublished, sortOrder])
  @@index([deletedAt])
  @@index([sortOrder])
  @@map("hero_slides")
}

/// Public website «مشتریان ما» showcase (manager CMS — not CRM)
model ShowcaseCustomer {
  id           String    @id @default(cuid())
  name         String
  companyName  String
  description  String?   @db.Text
  imageKey     String
  sortOrder    Int       @default(0)
  isPublished  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([isPublished, sortOrder])
  @@index([deletedAt])
  @@index([sortOrder])
  @@map("showcase_customers")
}

/// Public website Contact Us submissions (manager inbox)
model ContactMessage {
  id            String       @id @default(cuid())
  name          String
  email         String
  phone         String
  company       String?
  subject       String
  message       String       @db.Text
  isRead        Boolean      @default(false)
  readAt        DateTime?
  ipAddress     String?
  userAgent     String?
  crmCustomerId String?
  crmCustomer   CrmCustomer? @relation(fields: [crmCustomerId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([isRead, createdAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([email])
  @@index([crmCustomerId])
  @@map("contact_messages")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("settings")
}

enum PortfolioStatus {
  PUBLISHED
  UNPUBLISHED
}

enum BackupType {
  MANUAL
  AUTOMATIC
}

enum BackupStatus {
  PROCESSING
  SUCCESS
  FAILED
}

model SystemBackup {
  id           String       @id @default(cuid())
  type         BackupType   @default(MANUAL)
  status       BackupStatus @default(PROCESSING)
  fileName     String?
  storageKey   String?
  sizeBytes    Int          @default(0)
  checksum     String?
  tableCount   Int          @default(0)
  recordCount  Int          @default(0)
  errorMessage String?
  emailTo      String?
  emailSentAt  DateTime?
  /// Soft email-delivery failure after a successful backup (not a backup failure).
  emailError   String?
  createdById  String?
  createdBy    User?        @relation("BackupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedAt  DateTime?
  createdAt    DateTime     @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([type])
  @@map("system_backups")
}

// ─── Internal Chat ───────────────────────────────────────

enum ChatConversationType {
  DIRECT
  GROUP
}

enum ChatMessageType {
  TEXT
  VOICE
  IMAGE
  FILE
  SYSTEM
}

enum ChatAttachmentKind {
  IMAGE
  DOCUMENT
  VOICE
  AUDIO
  OTHER
}

/// Manager-controlled policy for employee ↔ employee messaging.
/// Managers/Admins may always message anyone; employees may always message managers.
enum ChatEmployeePolicy {
  DISABLED
  ALL_EMPLOYEES
  SAME_TEAM
  SELECTED
}

model ChatOrgSettings {
  id             String             @id @default("default")
  employeePolicy ChatEmployeePolicy @default(DISABLED)
  updatedById    String?
  updatedBy      User?              @relation("ChatOrgSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("chat_org_settings")
}

/// Explicit allow-list pairs when employeePolicy = SELECTED (unordered via userLow/userHigh).
model ChatEmployeeAllowPair {
  id          String   @id @default(cuid())
  userLowId   String
  userHighId  String
  grantedById String
  createdAt   DateTime @default(now())

  userLow   User @relation("ChatAllowPairLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh  User @relation("ChatAllowPairHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  grantedBy User @relation("ChatAllowPairGranter", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userLowId])
  @@index([userHighId])
  @@map("chat_employee_allow_pairs")
}

model ChatConversation {
  id            String               @id @default(cuid())
  type          ChatConversationType @default(DIRECT)
  /// Sorted "userA:userB" for DIRECT uniqueness; null for GROUP.
  directKey     String?              @unique
  title         String?
  createdById   String
  createdBy     User                 @relation("ChatConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lastMessageAt DateTime?
  lastMessagePreview String?
  archivedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([lastMessageAt])
  @@index([deletedAt])
  @@index([type])
  @@map("chat_conversations")
}

model ChatParticipant {
  id                String    @id @default(cuid())
  conversationId    String
  conversation      ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt          DateTime  @default(now())
  lastReadAt        DateTime?
  lastReadMessageId String?
  mutedAt           DateTime?
  pinnedAt          DateTime?
  archivedAt        DateTime?
  leftAt            DateTime?

  @@unique([conversationId, userId])
  @@index([userId, archivedAt])
  @@index([userId, pinnedAt])
  @@index([conversationId])
  @@map("chat_participants")
}

model ChatMessage {
  id              String          @id @default(cuid())
  conversationId  String
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User            @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  type            ChatMessageType @default(TEXT)
  body            String?
  /// Client-generated id for idempotent send/retry (unique per sender when set).
  clientMessageId String?
  replyToId       String?
  replyTo         ChatMessage?    @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         ChatMessage[]   @relation("ChatMessageReplies")
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  attachments ChatAttachment[]
  reactions   ChatMessageReaction[]
  deliveries  ChatMessageDelivery[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([conversationId, id])
  @@index([senderId])
  @@index([deletedAt])
  @@map("chat_messages")
}

model ChatAttachment {
  id         String             @id @default(cuid())
  messageId  String
  message    ChatMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  kind       ChatAttachmentKind @default(OTHER)
  durationMs Int?
  createdAt  DateTime           @default(now())

  @@index([messageId])
  @@index([storageKey])
  @@map("chat_attachments")
}

model ChatMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_message_reactions")
}

model ChatMessageDelivery {
  id          String    @id @default(cuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt DateTime?
  readAt      DateTime?

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@index([messageId])
  @@map("chat_message_deliveries")
}

// ─── Sales Assistant Agent ────────────────────────────────

model SalesAssistantSettings {
  id                       String   @id @default("default")
  enabled                  Boolean  @default(true)
  decisionWaitingDays      Int      @default(2)
  pendingDepositDays       Int      @default(1)
  repeatOrderMinDays       Int      @default(45)
  repeatOrderMaxDays       Int      @default(180)
  skipIfActiveHours        Int      @default(18)
  dailyReportEnabled       Boolean  @default(true)
  dailyReportHour          Int      @default(8)
  dailyReportMinute        Int      @default(0)
  notifyRepOnHigh          Boolean  @default(true)
  notifyManagerOnHigh      Boolean  @default(true)
  highValueMinOrders       Int      @default(2)
  scanIntervalHours        Int      @default(6)
  priorityRules            Json?
  updatedAt                DateTime @updatedAt
  updatedById              String?
  updatedBy                User?    @relation("SalesAssistantSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("sales_assistant_settings")
}

model SalesAssistantRecommendation {
  id              String      @id @default(cuid())
  crmCustomerId   String
  crmCustomer     CrmCustomer @relation(fields: [crmCustomerId], references: [id], onDelete: Cascade)
  salesOwnerId    String?
  salesOwner      User?       @relation("SalesAssistantOwner", fields: [salesOwnerId], references: [id], onDelete: SetNull)
  kind            String
  category        String
  priority        String
  actionState     String      @default("NEW")
  fingerprint     String
  title           String
  reason          String      @db.Text
  whatHappened    String?     @db.Text
  customerWants   String?     @db.Text
  whatsStopping   String?     @db.Text
  recommendedAction String    @db.Text
  suggestedMessage String?    @db.Text
  salesApproach   String?     @db.Text
  closeHelp       String?     @db.Text
  facts           Json?
  interpretations Json?
  evidence        Json?
  pipelineStage   String
  daysInStage     Decimal?    @db.Decimal(8, 2)
  lastInteractionAt DateTime?
  intentLevel     String?
  aiModel         String?
  aiPromptVersion String?
  usedAi          Boolean     @default(false)
  actedAt         DateTime?
  actedById       String?
  actedBy         User?       @relation("SalesAssistantActor", fields: [actedById], references: [id], onDelete: SetNull)
  actionTaken     String?
  actionNotes     String?     @db.Text
  viewedAt        DateTime?
  supersededAt    DateTime?
  supersededById  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([crmCustomerId, actionState])
  @@index([crmCustomerId, kind])
  @@index([salesOwnerId, actionState])
  @@index([category, priority])
  @@index([fingerprint])
  @@index([createdAt])
  @@index([supersededAt])
  @@map("sales_assistant_recommendations")
}

model SalesAssistantDailyReport {
  id          String   @id @default(cuid())
  reportDate  DateTime @db.Date
  generatedAt DateTime @default(now())
  summary     Json
  snapshot    Json
  createdAt   DateTime @default(now())

  @@unique([reportDate])
  @@index([reportDate])
  @@map("sales_assistant_daily_reports")
}

model SalesAssistantRun {
  id          String    @id @default(cuid())
  trigger     String
  eventType   String?
  customerId  String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String    @default("RUNNING")
  stats       Json?
  error       String?   @db.Text

  @@index([startedAt])
  @@index([trigger, startedAt])
  @@map("sales_assistant_runs")
}

// ─── Business Assistant Agent ─────────────────────────────

model BusinessAssistantSettings {
  id                  String   @id @default("default")
  enabled             Boolean  @default(true)
  weeklyReportEnabled Boolean  @default(true)
  weeklyReportDay     Int      @default(1)
  weeklyReportHour    Int      @default(8)
  weeklyReportMinute  Int      @default(0)
  receivableAlertPct  Int      @default(30)
  overdueProjectDays  Int      @default(3)
  profitTargetGapPct  Int      @default(15)
  pipelineStuckDays   Int      @default(7)
  notifyManagerOnHigh Boolean  @default(true)
  updatedAt           DateTime @updatedAt
  updatedById         String?
  updatedBy           User?    @relation("BusinessAssistantSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("business_assistant_settings")
}

model BusinessAssistantInsight {
  id                String    @id @default(cuid())
  kind              String
  category          String
  scope             String    @default("COMPANY")
  priority          String
  actionState       String    @default("NEW")
  fingerprint       String
  title             String
  reason            String    @db.Text
  strengthOrWeakness String?
  recommendedAction String    @db.Text
  actionPlan        String?   @db.Text
  weeklyStrategy    String?   @db.Text
  monthlyStrategy   String?   @db.Text
  facts             Json?
  evidence          Json?
  aiModel           String?
  aiPromptVersion   String?
  usedAi            Boolean   @default(false)
  actedAt           DateTime?
  actedById         String?
  actedBy           User?     @relation("BusinessAssistantActor", fields: [actedById], references: [id], onDelete: SetNull)
  actionTaken       String?
  actionNotes       String?   @db.Text
  viewedAt          DateTime?
  supersededAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([actionState, priority])
  @@index([category, priority])
  @@index([kind])
  @@index([fingerprint])
  @@index([createdAt])
  @@index([supersededAt])
  @@map("business_assistant_insights")
}

model BusinessAssistantWeeklyReport {
  id          String   @id @default(cuid())
  weekStart   DateTime @db.Date
  generatedAt DateTime @default(now())
  summary     Json
  snapshot    Json
  strategies  Json?
  createdAt   DateTime @default(now())

  @@unique([weekStart])
  @@index([weekStart])
  @@map("business_assistant_weekly_reports")
}

model BusinessAssistantMonthlyTarget {
  id               String    @id @default(cuid())
  year             Int
  month            Int
  status           String    @default("DRAFT")
  targets          Json
  aiRecommendation Json?
  managerNotes     String?   @db.Text
  progress         Json?
  createdById      String
  createdBy        User      @relation("BusinessAssistantTargetCreator", fields: [createdById], references: [id], onDelete: Cascade)
  finalizedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([year, month])
  @@index([year, month])
  @@map("business_assistant_monthly_targets")
}

model BusinessAssistantChatMessage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("BusinessAssistantChatter", fields: [userId], references: [id], onDelete: Cascade)
  role            String
  content         String   @db.Text
  contextSnapshot Json?
  usedAi          Boolean  @default(false)
  aiModel         String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@map("business_assistant_chat_messages")
}

model BusinessAssistantRun {
  id         String    @id @default(cuid())
  trigger    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING")
  stats      Json?
  error      String?   @db.Text

  @@index([startedAt])
  @@index([trigger, startedAt])
  @@map("business_assistant_runs")
}
