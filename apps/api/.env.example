# APEX API (Express + Prisma) — local / VPS
# Copy to apps/api/.env for local, or use apps/api/deploy/.env.production.example on the server.

NODE_ENV=development

# Process managers may inject PORT. Locally you may use API_PORT.
# PORT=4000
API_PORT=4000
# HOST=127.0.0.1

API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Shared secret for on-demand Next.js revalidation after portfolio/services publish
# (must match apps/web WEB_REVALIDATE_SECRET). Optional in local dev.
# WEB_REVALIDATE_SECRET=change-me-revalidate-secret-min-32-chars

# Optional: web-optimize portfolio videos (H.264/AAC + faststart). Install ffmpeg
# on the server, or set absolute paths:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Extra browser origins (comma-separated). Production same-domain usually needs only WEB_URL.
# CORS_ORIGINS=https://smartapex.tech

DATABASE_URL=postgresql://apex:apex_secret@localhost:5432/apex_workspace?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Same-origin (recommended on VPS): COOKIE_SECURE=true and COOKIE_SAME_SITE=lax
# Split-host only: COOKIE_SECURE=true and COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_SECRET=change-me-csrf-secret-min-32-characters!!

# Bunny.net (only storage provider)
# Copy values from the *current* Bunny account dashboard only — never hardcode
# another account's zone/key/CDN in source. Restart the API after changing these.
# Storage → FTP & API Access: zone name, password (API key), hostname (often regional,
# e.g. sg.storage.bunnycdn.com). Pull Zone → hostname (*.b-cdn.net).
STORAGE_DRIVER=bunny
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_CDN_HOSTNAME=
# BUNNY_CDN_TOKEN_KEY=
# Required for private files on a public pull zone. Without it, private objects
# are streamed through the authenticated API instead of unsigned CDN URLs.
BUNNY_STORAGE_PATH_PREFIX=apex
STORAGE_PUBLIC_BASE=https://YOUR_PULLZONE.b-cdn.net

# Web preview base (apps/web):
# NEXT_PUBLIC_STORAGE_PUBLIC_BASE=http://localhost:4000/files

# AI: openrouter | openai | anthropic | gemini | mock
AI_PROVIDER=mock
AI_ASYNC_PIPELINE=true
AI_MAX_RETRIES=3
AI_ALLOW_MOCK_FALLBACK=true
AI_REQUEST_TIMEOUT_MS=120000
AI_DEFAULT_MODEL=
AI_BACKUP_MODEL=
# Optional override. Leave empty to use the live OpenRouter free-model catalog
# (Settings → مدل‌های رایگان). Do not hard-code a paid model here for free-only mode.
# AI_MODEL_SALES_ASSISTANT=
# AI_MODEL_BUSINESS_ASSISTANT=google/gemini-2.0-flash-exp:free

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Storyboard stills via OpenRouter Image API (POST /images)
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# auto | openrouter | openai | free (Pollinations — no paid credits)
AI_IMAGE_PROVIDER=free
POLLINATIONS_IMAGE_MODEL=flux-realism
# POLLINATIONS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

DEFAULT_MANAGER_EMAIL=manager@apex.af
DEFAULT_MANAGER_PASSWORD=change-me-after-first-login
WHATSAPP_NUMBER=93700000000

# Meta WhatsApp Cloud API (optional — required for auto CRM leads from WhatsApp)
# Callback URL: {API_URL}/api/v1/public/webhooks/whatsapp
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=long-random-verify-token
# WHATSAPP_APP_SECRET=meta-app-secret
# WHATSAPP_ACCESS_TOKEN=meta-permanent-or-system-user-token
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# SMTP (optional — required to email backup archives)
# Required for automatic backup email delivery (Backup & Restore page)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="APEX Backup <backup@example.com>"
# Optional fallback when schedule emailTo is empty:
# BACKUP_EMAIL_TO=backup@example.com
# BACKUP_EMAIL_MAX_BYTES=15728640

# PORTAL_EXPOSE_OTP=true

# AES-256-GCM secret for recoverable portal passwords shown to authorized managers.
# If unset, JWT_ACCESS_SECRET is used. Prefer a dedicated value in production.
# PORTAL_CREDENTIAL_SECRET=change-me-portal-credential-secret-32chars!

SIGNED_URL_SECRET=change-me-signed-url-secret-32chars!
SIGNED_URL_TTL_SECONDS=300
TZ=Asia/Kabul
