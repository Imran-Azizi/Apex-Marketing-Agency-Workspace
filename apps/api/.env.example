# APEX API (Express + Prisma) — Railway
# Copy to apps/api/.env for local, or set in Railway Variables.

NODE_ENV=development

# Railway injects PORT automatically. Locally you may use API_PORT.
# PORT=4000
API_PORT=4000

API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Extra browser origins (comma-separated). Production should list your Vercel URL(s).
# CORS_ORIGINS=https://apex.vercel.app,https://apex-git-main.vercel.app

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway?schema=public&sslmode=require&connect_timeout=60

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cross-origin (Vercel ↔ Railway): COOKIE_SECURE=true and COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_SECRET=change-me-csrf-secret-min-32-characters!!

# cloudinary | s3 | r2
# - cloudinary: recommended for local/testing
# - r2 / s3: recommended for Railway production
STORAGE_DRIVER=cloudinary
STORAGE_PUBLIC_BASE=https://res.cloudinary.com/your_cloud_name

# Cloudinary — required when STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional account root folder (default: apex)
CLOUDINARY_FOLDER_PREFIX=apex
# For Cloudinary, keep the web preview base on the API /files redirect:
# (in apps/web) NEXT_PUBLIC_STORAGE_PUBLIC_BASE=http://localhost:4000/files

# S3-compatible (Cloudflare R2 / AWS S3 / MinIO) — required when STORAGE_DRIVER=s3|r2
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# R2 usually needs path-style off; MinIO often needs true
S3_FORCE_PATH_STYLE=false

# AI: openrouter | openai | anthropic | gemini | mock
AI_PROVIDER=mock
AI_ASYNC_PIPELINE=true
AI_MAX_RETRIES=3
AI_ALLOW_MOCK_FALLBACK=true
AI_REQUEST_TIMEOUT_MS=120000
AI_DEFAULT_MODEL=
AI_BACKUP_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Storyboard stills via OpenRouter Image API (POST /images)
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# auto | openrouter | openai | free (Pollinations — no paid credits)
AI_IMAGE_PROVIDER=free
POLLINATIONS_IMAGE_MODEL=flux-realism
# POLLINATIONS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

DEFAULT_MANAGER_EMAIL=manager@apex.af
DEFAULT_MANAGER_PASSWORD=change-me-after-first-login
WHATSAPP_NUMBER=93700000000

# SMTP (optional — required to email backup archives)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="APEX Backup <backup@example.com>"
# BACKUP_EMAIL_TO=backup@example.com
# BACKUP_EMAIL_MAX_BYTES=15728640

# PORTAL_EXPOSE_OTP=true

SIGNED_URL_SECRET=change-me-signed-url-secret-32chars!
SIGNED_URL_TTL_SECONDS=300
TZ=Asia/Kabul
